{
  // GitHub Codespaces / Dev Containers: everything needed for the workshop, no local installation.
  // Create a codespace on your fork: Code -> Codespaces -> Create codespace on main
  "name": "ODCS + ODPS Workshop",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/va-h/devcontainers-features/uv:1": {}
  },
  "postCreateCommand": "bash scripts/install.sh && docker compose up -d --wait",
  "forwardPorts": [5433],
  "portsAttributes": {
    "5433": { "label": "Workshop PostgreSQL", "onAutoForward": "silent" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["redhat.vscode-yaml", "mtxr.sqltools", "mtxr.sqltools-driver-pg"],
      "settings": {
        "yaml.schemas": {
          "./schemas/odcs-json-schema-v3.1.0.json": "*.odcs.yaml",
          "./schemas/odps-json-schema-v1.0.0.json": "*.odps.yaml"
        }
      }
    }
  }
}
